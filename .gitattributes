# Preserve printable documents and visual assets byte-for-byte.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.glb binary
*.zip binary
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# Preserve CAD and Office source files without newline conversion.
*.step binary
*.stp binary
*.stl binary
*.pptx binary
*.docx binary
