# Preserve printable documents and visual assets byte-for-byte.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.glb binary
*.zip binary
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# Preserve CAD and Office source files without newline conversion.
*.step binary
*.stp binary
*.stl binary
*.pptx binary
*.docx binary
# Assembly archives, editable projects and release hash manifests preserve bytes.
*.3mf binary
*.drp binary
*.xlsx binary
"05_程序与测试/双机2.0当前程序包_2026-11-14/**" -text
